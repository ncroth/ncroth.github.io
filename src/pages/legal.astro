---
import Layout from '../layouts/main.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LegalNoticeContent from '../components/LegalNoticeContent.astro';
import * as legalNotice from '../content/legal/de.md';
import { defaultLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

const lang = defaultLang;
const t = useTranslations(lang);
---

<Layout lang={lang} title={t('nav.impressum')}>
	<SiteHeader lang={lang} />
	<main id="main" class="mx-auto max-w-page px-4 py-16 sm:px-6 sm:py-20">
		<LegalNoticeContent>
			<legalNotice.Content />
		</LegalNoticeContent>
	</main>
	<SiteFooter lang={lang} />
</Layout>
