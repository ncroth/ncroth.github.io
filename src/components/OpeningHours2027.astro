---
import { type Lang, type UIKey } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

interface Props {
    lang: Lang;
}

// `time: null` means closed. `time: ""` means by appointment. Day names are translation keys.
const hours: { day: UIKey; time: string | null; time2: string | null }[] = [
    { day: "day.monday", time: "08:00 – 13:00", time2: "" },
    { day: "day.tuesday", time: "08:30 – 12:00", time2: "13:00 – 16:00" },
    { day: "day.wednesday", time: null, time2: null },
    { day: "day.thursday", time: "08:30 – 12:00", time2: "13:00 – 16:00" },
    { day: "day.friday", time: null, time2: null },
];

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    aria-labelledby="hours-2027-heading"
    class="rounded-2xl border border-line bg-surface p-5 shadow-sm sm:p-8"
>
    <h2
        id="hours-2027-heading"
        class="text-2xl font-semibold text-ink sm:text-3xl"
    >
        {t("hours.title.new")}
    </h2>
    <p class="mt-3 max-w-2xl text-muted">{t("hours.text.new")}</p>
    <table class="mt-8 w-full max-w-md border-collapse text-left">
        <caption class="sr-only">{t("hours.caption")}</caption>
        <thead>
            <tr class="border-b border-line-strong">
                <th scope="col" class="py-3 pr-4 font-semibold text-ink">
                    {t("hours.day")}
                </th>
                <th scope="col" class="py-3 font-semibold text-ink">
                    {t("hours.time")}
                </th>
                <th scope="col" class="py-3 hidden font-semibold text-ink"></th>
            </tr>
        </thead>
        <tbody>
            {hours.map(({ day, time, time2 }) => (
                <tr class="border-b border-line">
                    <th scope="row" class="py-3 pr-4 font-medium text-body">
                        {t(day)}
                    </th>
                    <td class="py-3 text-muted">
                        {time === null
                            ? t("hours.closed")
                            : time === ""
                              ? t("hours.note")
                              : time}
                    </td>
                    <td class="py-3 text-muted">
                        {time2 === null
                            ? t("hours.closed")
                            : time2 === ""
                              ? t("hours.note")
                              : time2}
                    </td>
                </tr>
            ))}
        </tbody>
    </table>
</section>
